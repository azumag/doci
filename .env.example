# ---- text generation (台本) ----
# backend: claude_cli (opus) | anthropic (API key) | opencode (任意モデル)
# 既定は opencode + minimax-m3（創造性重視で採用）。opus に戻すなら claude_cli。
TEXT_BACKEND=opencode
TEXT_MODEL=claude-opus-4-8
# only needed when TEXT_BACKEND=anthropic (cloud path)
ANTHROPIC_API_KEY=
# TEXT_BACKEND=opencode のとき: provider/model を直指定（--agent より優先）
OPENCODE_MODEL=opencode-go/minimax-m3
# 旧来の agent 指定（OPENCODE_MODEL 未設定時のみ使用）
OPENCODE_AGENT=

# ---- media generation (画像/動画) ----
# IMAGE_BACKEND: gemini (既定/推奨) | openrouter | minimax
IMAGE_BACKEND=gemini
# VIDEO_BACKEND: none (既定。v1は動画なし) | minimax
VIDEO_BACKEND=none

# 画像: Gemini 2.5 Flash Image (nano banana)。AI Studio 無料キーで動く。
#   キー取得: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_API_VERSION=v1beta

# 画像: OpenRouter（代替。クレジット要）
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# 画像/動画: Minimax（※コーディング/トークンプランのキーはメディア枠0で不可。
#   image/videoを使うにはMinimaxプラットフォームでメディアトークンを有効化すること）
MINIMAX_API_KEY=
MINIMAX_MEDIA_BASE_URL=https://api.minimax.io/v1
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-2.3
# 動画化するシーン数（VIDEO_BACKEND=minimax のとき有効。0=静止画のみ）
MINIMAX_VIDEO_SCENES=0

# ---- TTS (VOICEVOX) ----
VOICEVOX_URL=http://192.168.11.13:50021
VOICEVOX_URL_FALLBACK=http://127.0.0.1:50021
# speaker ids: chinese_ai=3 (ずんだもん), american_ai=14 (冥鳴ひまり)
VOICE_CHINESE_AI=3
VOICE_AMERICAN_AI=14

# ---- YouTube upload ----
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json
# unlisted | private | public
YOUTUBE_PRIVACY=unlisted

# ---- video shape ----
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
BGM_VOLUME=0.12
