# ---- text generation (台本) ----
# backend: claude_cli (opus) | anthropic (API key) | opencode (任意モデル)
# 既定は opencode + minimax-m3（創造性重視で採用）。opus に戻すなら claude_cli。
TEXT_BACKEND=opencode
TEXT_MODEL=claude-opus-4-8
# only needed when TEXT_BACKEND=anthropic (cloud path)
ANTHROPIC_API_KEY=
# TEXT_BACKEND=opencode のとき: provider/model を直指定（--agent より優先）
OPENCODE_MODEL=opencode-go/minimax-m3
# 旧来の agent 指定（OPENCODE_MODEL 未設定時のみ使用）
OPENCODE_AGENT=

# 台本品質 (issue #6): 前段リサーチ＋後段ファクトチェック（既定OFF）。
#   SCRIPT_RESEARCH=1: 下書き前に claude CLI(Web)で題材選定＋実ソース裏取り。
#   SCRIPT_FACTCHECK=1: 下書き後に opus+Web で事実検証し narration を自動修正。
#   ※ それぞれ claude CLI 呼び出し1回(Web検索あり)で時間/コスト増（実測 約40-60秒・$0.2〜/回）。
SCRIPT_RESEARCH=0
SCRIPT_FACTCHECK=0
RESEARCH_MODEL=claude-sonnet-4-6
FACTCHECK_MODEL=claude-opus-4-8
SCRIPT_LLM_TIMEOUT=300

# ---- media sourcing (素材調達; issue #9) ----
# ASSET_BACKEND: pexels (既定/実フリー素材・縦・商用OK・帰属不要) | none(常にAI生成)
#   素材が取れなければ下の IMAGE_BACKEND のAI生成へ自動フォールバック。
ASSET_BACKEND=pexels
# Pexels 無料キー: https://www.pexels.com/api/ （商用OK・帰属不要）
PEXELS_API_KEY=
# 検索の向き(portrait=縦) と 1回の候補数(使い回しバリエーション元)
PEXELS_ORIENTATION=portrait
ASSET_PER_PAGE=30
# 素材種別: photo(既定) | video(全シーン動画優先) | mix(シーン主画=動画/使い回し=写真)。
#   動画は Pexsels Videos。無ければ写真→AI生成へフォールバック。compose側で9:16クロップ＆尺ループ。
ASSET_MEDIA=photo

# ---- media generation (画像/動画) ----
# IMAGE_BACKEND: gemini (既定/推奨) | openrouter | minimax  ← 素材が無い時のフォールバック
IMAGE_BACKEND=gemini
# VIDEO_BACKEND: none (既定。v1は動画なし) | minimax
VIDEO_BACKEND=none

# 画像: Gemini 2.5 Flash Image (nano banana)。AI Studio 無料キーで動く。
#   キー取得: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_API_VERSION=v1beta

# 画像: OpenRouter（代替。クレジット要）
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# 画像/動画: Minimax（※コーディング/トークンプランのキーはメディア枠0で不可。
#   image/videoを使うにはMinimaxプラットフォームでメディアトークンを有効化すること）
MINIMAX_API_KEY=
MINIMAX_MEDIA_BASE_URL=https://api.minimax.io/v1
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-2.3
# 動画化するシーン数（VIDEO_BACKEND=minimax のとき有効。0=静止画のみ）
MINIMAX_VIDEO_SCENES=0

# ---- TTS (VOICEVOX) ----
VOICEVOX_URL=http://192.168.11.13:50021
VOICEVOX_URL_FALLBACK=http://127.0.0.1:50021
# speaker ids: chinese_ai=3 (ずんだもん), american_ai=14 (冥鳴ひまり)
VOICE_CHINESE_AI=3
VOICE_AMERICAN_AI=14

# ---- 配信投稿 (issue #3) ----
# do_upload(--no-upload で無効) が大元のスイッチ。その上で各プラットフォームを個別に有効化。
# route.platforms（短尺=YT/TikTok/IG、長尺=YT通常動画）と下記フラグで出し分ける。
PUBLISH_DRY_RUN=0          # 1=実投稿せずログのみ（安全確認用）
PUBLISH_YOUTUBE=1
PUBLISH_TIKTOK=0
PUBLISH_INSTAGRAM=0        # 後回し（公開ホスト方針未定）

# ---- YouTube upload ----
# 初回: client_secret.json(GoogleCloud OAuth)を置いて python -m doci.youtube --auth
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json
# unlisted | private | public
YOUTUBE_PRIVACY=unlisted

# ---- TikTok upload (Content Posting API) ----
# 開発者アプリ https://developers.tiktok.com/ で client_key/secret。scope=video.publish。
# 初回: python -m doci.tiktok --auth 。審査前は SELF_ONLY のみ可。
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_TOKEN_FILE=tiktok_token.json
# SELF_ONLY(非公開・審査前) | PUBLIC_TO_EVERYONE(審査後)
TIKTOK_PRIVACY=SELF_ONLY
TIKTOK_REDIRECT_URI=http://127.0.0.1:8723/callback

# ---- Instagram upload (Graph API・後回し) ----
# 動画は公開URLから取得される仕様→公開ホスト(R2等)が要る。ホスト方針未定のため未実装。
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_HOST_BASE=

# ---- video shape ----
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
BGM_VOLUME=0.12
