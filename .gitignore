# secrets / auth
.env
secrets/
*.client_secret.json
client_secret*.json
youtube_token.json
*token*.json

# generated artifacts
output/
*.wav
*.mp3.tmp
__pycache__/
*.pyc
.venv/
venv/

# os
.DS_Store
._*

# keep bundled BGM (assets/bgm) but ignore stray audio elsewhere
!assets/bgm/*.mp3
!assets/bgm/*.ogg
!assets/bgm/*.wav
.venv-cron/
tools/ffbin/
*.egg-info/
# codex exec 用の隔離ホーム(MiniMax APIキーを含む config.toml を生成する)
.codex-doci/
# CODEX_PROVIDER=chatgpt 用の隔離ホーム(実 ~/.codex の auth.json のコピーを含む)
.codex-doci-chatgpt/
# 実 auth.json の書き戻し前バックアップ(認証情報を含む)
.codex-doci-chatgpt-backup/
